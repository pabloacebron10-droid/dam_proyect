// Plantilla de ejemplo para `firebase_options.dart`.
// Este archivo sirve como referencia de la estructura esperada por Firebase.
// Genera tu propio `firebase_options.dart` ejecutando `flutterfire configure`.

import 'package:firebase_core/firebase_core.dart' show FirebaseOptions;
import 'package:flutter/foundation.dart'
    show defaultTargetPlatform, kIsWeb, TargetPlatform;

class DefaultFirebaseOptions {
  static FirebaseOptions get currentPlatform {
    if (kIsWeb) {
      return web;
    }
    switch (defaultTargetPlatform) {
      case TargetPlatform.android:
        return android;
      case TargetPlatform.iOS:
        return ios;
      default:
        throw UnsupportedError(
          'Plataforma no configurada en firebase_options.dart.example',
        );
    }
  }

  static const FirebaseOptions web = FirebaseOptions(
    apiKey: 'DEMO_EMULATOR_API_KEY_WEB',
    appId: '1:942238332444:web:6b2bafc58e333a04d691d9',
    messagingSenderId: '942238332444',
    projectId: 'proyectodam-56a61',
    authDomain: 'proyectodam-56a61.firebaseapp.com',
    storageBucket: 'proyectodam-56a61.firebasestorage.app',
  );

  static const FirebaseOptions android = FirebaseOptions(
    apiKey: 'DEMO_EMULATOR_API_KEY_ANDROID',
    appId: '1:942238332444:android:a6bf2ffb65bb8ee3d691d9',
    messagingSenderId: '942238332444',
    projectId: 'proyectodam-56a61',
    storageBucket: 'proyectodam-56a61.firebasestorage.app',
  );

  static const FirebaseOptions ios = FirebaseOptions(
    apiKey: 'DEMO_EMULATOR_API_KEY_IOS',
    appId: '1:942238332444:ios:2b87472f05daee77d691d9',
    messagingSenderId: '942238332444',
    projectId: 'proyectodam-56a61',
    storageBucket: 'proyectodam-56a61.firebasestorage.app',
    iosBundleId: 'com.example.damProyect',
  );
}
